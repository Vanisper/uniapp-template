# 所有 mode 的公共默认值，本机配置使用 .env.local 或 .env.[mode].local
UNI_MP_WEIXIN_APPID=

# 空地址用于 Mock 演示；接入后端时填写完整 HTTP(S) 地址，可包含 /api 前缀
VITE_API_BASE_URL=
VITE_REQUEST_TIMEOUT=10000
# 这里只配置鉴权格式，实际 Token 由运行时的 getToken 提供
VITE_AUTH_HEADER_NAME=Authorization
# 设为空值时直接发送 Token；非空前缀与 Token 之间自动加一个空格
VITE_AUTH_TOKEN_PREFIX=Bearer
VITE_AUTH_TOKEN_KEY=uniapp-template:auth:token
VITE_MOCK_DELAY=500
VITE_MOCK_ENABLED=false
# 输出经过脱敏的 Mock 适配器日志，production 模式不会引入该适配器
VITE_MOCK_LOG_ENABLED=true
